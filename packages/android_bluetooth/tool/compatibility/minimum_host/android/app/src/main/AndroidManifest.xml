<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Bluetooth compatibility">
        <activity android:name="com.jamcorder.android_bluetooth_minimum_host.MainActivity"
            android:exported="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data android:name="flutterEmbedding" android:value="2" />
    </application>
</manifest>
